{
  "name": "firmware-update-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":"tsx watch src/server.ts",
    "start":"tsx src/server.ts",
    "build":"vite build",
    "typecheck":"tsc --noEmit && tsc -p tsconfig.app.json --noEmit",
    "db:generate":"prisma generate",
    "db:migrate":"prisma migrate dev --name init",
    "db:seed":"tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client":"^6.16.2",
    "express":"^5.1.0",
    "multer":"^2.0.2",
    "react":"^19.1.1",
    "react-dom":"^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite":"^4.1.13",
    "@types/express":"^5.0.3",
    "@types/multer":"^2.0.0",
    "@types/node":"^22.18.6",
    "@types/react":"^19.1.12",
    "@types/react-dom":"^19.1.9",
    "@vitejs/plugin-react":"^5.0.2",
    "prisma":"^6.16.2",
    "tailwindcss":"^4.1.13",
    "tsx":"^4.20.5",
    "typescript":"^5.9.2",
    "vite":"^7.1.7"
  }
}
